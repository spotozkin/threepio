# THREEPIO Raspberry Pi environment
# Copy to config/pi.env and fill in API keys. Used by systemd: EnvironmentFile=/home/pi/threepio/config/pi.env

# --- Required API keys (fill placeholders) ---
OPENAI_API_KEY=sk-your-key-here
# Optional, for ElevenLabs TTS:
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=

# --- Providers ---
PROVIDER_LLM=openai
PROVIDER_STT=whisper
PROVIDER_TTS=openai

# --- Pi defaults ---
APP_NAME=threepio
LOG_LEVEL=INFO
# Use aplay for I2S DAC (e.g. MAX98357A)
AUDIO_OUTPUT_MODE=aplay
STT_MODEL=small
STT_LANGUAGE=en
ENABLE_C3PO_FX=false

# --- Barge-in: assisted = no STT during playback; interrupt via button (GPIO) later. off = no interrupt. full = correlation barge-in.
BARGE_IN_MODE=assisted

# --- Audio devices (fill after running: aplay -l and arecord -l) ---
# Input: device index or substring of device name (e.g. 1 or "INMP441" or "seeed")
# Output: leave blank for default, or ALSA device (e.g. plughw:1,0) if aplay needs -D
THREEPIO_AUDIO_INPUT_DEVICE=
THREEPIO_AUDIO_OUTPUT_DEVICE=

# --- Optional: memory, utterance, VAD ---
# MEMORY_TURNS=5
# MIN_UTTERANCE_SEC=1.2
# UTTERANCE_END_SILENCE_MS=350
# UTTERANCE_MAX_MS=2500
# UTTERANCE_MIN_MS=450
# UTTERANCE_MIN_RMS=0.010
# UTTERANCE_MIN_WORDS=2

# --- Optional: eyes (NeoPixel on Pi) ---
# PROVIDER_EYES=neopixel
# EYES_PIN=D18
# EYES_PIXEL_COUNT=24
# EYES_BRIGHTNESS=0.35
