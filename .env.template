# Copy this file to .env for deployment and fill in your API keys.
# Do not commit .env or real API keys to version control.

OPENAI_API_KEY=
ELEVENLABS_API_KEY=

PROVIDER_LLM=openai
PROVIDER_STT=whisper
PROVIDER_TTS=elevenlabs

STT_MODEL=tiny
ENABLE_C3PO_FX=true
AUDIO_OUTPUT_MODE=auto

# Utterance segmentation (silence hangover / max duration to finalize and run STT gate)
# UTTERANCE_END_SILENCE_MS=350
# UTTERANCE_MAX_MS=2500

# Barge-in: off (no mic processing during playback) | assisted (keypress/GPIO only) | full (correlation barge-in)
# BARGE_IN_MODE=full

# Barge-in tuning (ambient: min speech ms and min RMS to accept interrupt during TTS)
# BARGE_IN_MIN_SPEECH_MS=450
# BARGE_IN_MIN_RMS=0.03
# BARGE_IN_PLAYBACK_WARMUP_MS=350
