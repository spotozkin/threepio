# THREEPIO Configuration
# Copy to .env and adjust as needed

# OpenAI (required for Realtime API; optional for CLI-only mode)
OPENAI_API_KEY=sk-your-key-here

APP_NAME=threepio
LOG_LEVEL=INFO

# Memory: number of recent dialogue turns to retain
MEMORY_TURNS=5

# Provider names (e.g., mock, openai, whisper, etc.)
PROVIDER_STT=mock
PROVIDER_LLM=mock
PROVIDER_TTS=mock

# OpenAI TTS (optional - omit to use MockTTS)
# OPENAI_API_KEY=sk-...
# TTS_VOICE=alloy
# TTS_MODEL=gpt-4o-mini-tts
# AUDIO_OUTPUT_MODE: auto (platform default), afplay, ffplay, aplay, mpg123, or print. macOS: auto/afplay. Pi/Linux: auto, ffplay, aplay, mpg123 (not afplay).
# AUDIO_OUTPUT_MODE=auto

# Realtime voice (pip install -e ".[realtime]")
# PROVIDER_VOICE=realtime
# REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17
# REALTIME_VOICE=alloy
# AUDIO_INPUT_DEVICE=
# AUDIO_OUTPUT_DEVICE=

# Ambient mode (python -m threepio.modes.ambient or --ambient): mic and utterance
# THREEPIO_AUDIO_INPUT_DEVICE=1
# THREEPIO_MIN_UTTERANCE_SEC=0.7
# ENABLE_C3PO_FX=true
# Barge-in: suppression window (ms) after playback start; default 2000
# THREEPIO_SPEECH_SUPPRESS_MS=2000
# Stricter barge-in: sustained frames (e.g. 10=300ms), RMS multiplier (e.g. 2.0)
# THREEPIO_BARGEIN_SUSTAINED_FRAMES=10
# THREEPIO_BARGEIN_RMS_MULTIPLIER=2.0
# THREEPIO_ENABLE_BARGE_IN=true

# C-3PO voice FX (ffmpeg; canonical _AB_fix1). Used by --tts-test and ambient TTS.
# C3PO_FX_STYLE=ab_fix1
# C3PO_FX_INTENSITY=1.0
# C3PO_FX_VOLUME=0.95
# C3PO_FX_HIGHPASS=110
# C3PO_FX_LOWPASS=12000
# C3PO_FX_COMP_THRESHOLD_DB=-20
# C3PO_FX_COMP_RATIO=3
# C3PO_FX_COMP_ATTACK=5
# C3PO_FX_COMP_RELEASE=90
# C3PO_ECHO_IN=0.6
# C3PO_ECHO_OUT=0.75
# C3PO_ECHO_DELAYS=14|28
# C3PO_ECHO_DECAYS=0.18|0.12
# C3PO_LIMIT=0.95
# ELEVENLABS_SPEED=1.0
# robot_v1 style adds ringmod+chorus: C3PO_FX_STYLE=robot_v1
