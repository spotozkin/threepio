# THREEPIO Configuration
# Copy to .env and adjust as needed

# OpenAI (required for Realtime API; optional for CLI-only mode)
OPENAI_API_KEY=sk-your-key-here

APP_NAME=threepio
LOG_LEVEL=INFO

# Memory: number of recent dialogue turns to retain
MEMORY_TURNS=5

# Provider names (e.g., mock, openai, whisper, etc.)
PROVIDER_STT=mock
PROVIDER_LLM=mock
PROVIDER_TTS=mock

# OpenAI TTS (optional - omit to use MockTTS)
# OPENAI_API_KEY=sk-...
# TTS_VOICE=alloy
# TTS_MODEL=gpt-4o-mini-tts
# AUDIO_OUTPUT_MODE=play

# Realtime voice (pip install -e ".[realtime]")
# PROVIDER_VOICE=realtime
# REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17
# REALTIME_VOICE=alloy
# AUDIO_INPUT_DEVICE=
# AUDIO_OUTPUT_DEVICE=
